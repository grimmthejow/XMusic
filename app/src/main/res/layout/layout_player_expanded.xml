<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/expanded_player_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipToOutline="true">

    <com.xapps.media.xmusic.widget.SmallToggleView
        android:id="@+id/favorite_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:background="@drawable/circle_shape"
        android:src="@drawable/ic_favorite_outlined"
        android:tint="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/title_container"
        app:layout_constraintBottom_toBottomOf="@id/title_container" />

    <LinearLayout
        android:id="@+id/title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintStart_toEndOf="@id/favorite_button"
        app:layout_constraintEnd_toStartOf="@id/save_button"
        app:layout_constraintTop_toTopOf="parent">

        <com.xapps.media.xmusic.widget.MarqueeTextView
            android:id="@+id/song_big_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp"
            android:paddingBottom="2dp"
            android:textSize="22sp"
            android:gravity="center_horizontal"
            android:textColor="?colorOnSurface" />

        <com.xapps.media.xmusic.widget.MarqueeTextView
            android:id="@+id/artist_big_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="?colorOutline" />

    </LinearLayout>

    <com.xapps.media.xmusic.widget.SmallToggleView
        android:id="@+id/save_button"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="16dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:background="@drawable/circle_shape"
        android:src="@drawable/ic_playlist_add"
        android:tint="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title_container"
        app:layout_constraintBottom_toBottomOf="@id/title_container" />

    <com.xapps.media.xmusic.widget.XSeekbar
        android:id="@+id/song_seekbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="0dp"
        android:enabled="false"
        android:progress="0"
        app:layout_constraintTop_toBottomOf="@id/title_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/current_duration_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:gravity="start"
        android:text="00:00"
        android:textColor="?colorOutline"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/total_duration_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/song_seekbar"
        tools:ignore="TextContrastCheck" />

    <TextView
        android:id="@+id/total_duration_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:text="00:00"
        android:textColor="?colorOutline"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/song_seekbar"
        tools:ignore="TextContrastCheck" />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/controls_flow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:constraint_referenced_ids="previous_button,toggle_view,next_button"
        app:flow_horizontalGap="24dp"
        app:flow_horizontalStyle="packed"
        app:layout_constraintTop_toBottomOf="@+id/total_duration_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.xapps.media.xmusic.widget.SmallToggleView
        android:id="@+id/previous_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="15dp"
        android:background="@drawable/circle_shape"
        android:src="@drawable/icon_skip_previous_outline"
        android:tint="?attr/colorOnSurface" />

    <com.xapps.media.xmusic.widget.NewPlayerToggle
        android:id="@+id/toggle_view"
        android:layout_width="105dp"
        android:layout_height="105dp"
        android:gravity="center" />

    <com.xapps.media.xmusic.widget.SmallToggleView
        android:id="@+id/next_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="15dp"
        android:background="@drawable/circle_shape"
        android:src="@drawable/icon_skip_next_outline"
        android:tint="?attr/colorOnSurface" />

    <com.xapps.media.xmusic.widget.PillBackgroundView
        android:id="@+id/song_info_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/song_info_text"
        app:layout_constraintBottom_toBottomOf="@id/song_info_text" />

    <TextView
        android:id="@+id/song_info_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Unknown"
        android:textColor="#BDBDBD"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/controls_flow" />

    <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
        android:id="@+id/floating_toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal" >

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lyrics_button"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    app:icon="@drawable/ic_lyrics_selector" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/repeat_mode_button"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>

</androidx.constraintlayout.widget.ConstraintLayout>