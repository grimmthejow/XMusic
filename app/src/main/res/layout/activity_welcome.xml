<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/top_window"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical">
        </LinearLayout>
        <LinearLayout
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:transitionGroup="true">
            <FrameLayout
                android:id="@+id/first_screen"
                android:layout_height="match_parent"
                android:layout_width="match_parent">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:lottie_rawRes="@raw/onboarding"
                    app:lottie_loop="true"
                    app:lottie_autoPlay="true" />
                <LinearLayout
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_gravity="bottom"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/top_title"
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:textSize="35sp"
                        android:textColor="?colorPrimary"
                        android:text="XMusic" />
                    <TextView
                        android:id="@+id/top_subtitle"
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:layout_marginStart="16dp"
                        android:textSize="25sp"
                        android:textColor="?colorOnSurface"
                        android:text="@string/welcome_tagline" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/begin_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="16dp"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:text="@string/welcome_start"
                    android:layout_margin="16dp"
                    android:layout_gravity="bottom|center_horizontal" />
            </FrameLayout>
            <LinearLayout
                android:id="@+id/second_screen"
                android:layout_height="match_parent"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:orientation="vertical">
                <androidx.core.widget.NestedScrollView
                    android:layout_height="0dp"
                    android:layout_width="match_parent"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_height="match_parent"
                        android:layout_width="match_parent"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/screen2_text"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:layout_marginStart="15dp"
                            android:textSize="25sp"
                            android:textColor="?colorOnSurface"
                            android:text="@string/welcome_grant_permissions" />
                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:layout_marginStart="15dp"
                            android:textSize="20sp"
                            android:textColor="?colorOutline"
                            android:text="@string/welcome_permissions_desc" />
                        <ImageView
                            android:id="@+id/illustration2"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:src="@drawable/intro_illustration_2"
                            android:adjustViewBounds="true"
                            android:layout_margin="50dp" />
                        <LinearLayout
                            android:layout_height="match_parent"
                            android:layout_width="match_parent"
                            android:orientation="vertical"
                            android:gravity="top">
                            <LinearLayout
                                android:id="@+id/first_item"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:paddingVertical="16dp"
                                android:paddingHorizontal="16dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/checkable_background_top_inverse">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/firstTitle"
                                        android:layout_height="wrap_content"
                                        android:layout_width="wrap_content"
                                        android:text="@string/welcome_media_access"
                                        android:textSize="20sp"
                                        android:layout_marginBottom="4dp"
                                        android:textColor="?colorOnSurface"
                                        tools:ignore="TooDeepLayout" />

                                    <TextView
                                        android:id="@+id/firstDesc"
                                        android:layout_height="wrap_content"
                                        android:layout_width="wrap_content"
                                        android:text="@string/welcome_media_access_desc"
                                        android:textSize="14sp"
                                        android:textColor="?colorOutline" />

                                </LinearLayout>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/first_grant_button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/grant" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/second_item"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginHorizontal="16dp"
                                android:paddingVertical="16dp"
                                android:paddingHorizontal="16dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/checkable_background_bottom_inverse">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/secondTitle"
                                        android:layout_height="wrap_content"
                                        android:layout_width="wrap_content"
                                        android:text="@string/welcome_media_access"
                                        android:textSize="20sp"
                                        android:layout_marginBottom="4dp"
                                        android:textColor="?colorOnSurface" />

                                    <TextView
                                        android:id="@+id/secondDesc"
                                        android:layout_height="wrap_content"
                                        android:layout_width="wrap_content"
                                        android:text="@string/welcome_media_access_desc"
                                        android:textSize="14sp"
                                        android:textColor="?colorOutline" />

                                </LinearLayout>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/second_grant_button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/grant" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/screen2_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/next"
                    android:layout_margin="8dp"
                    android:layout_gravity="right"
                    tools:ignore="RtlHardcoded" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/third_screen"
                android:layout_height="match_parent"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:gravity="center"
                android:orientation="vertical">
                <androidx.core.widget.NestedScrollView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent">
                    <LinearLayout
                        android:id="@+id/part_1_view"
                        android:layout_height="match_parent"
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/tg_icon"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:padding="25dp"
                            android:src="@drawable/intro_illustration_3"
                            android:adjustViewBounds="true"
                            android:layout_marginHorizontal="64dp" />
                        <TextView
                            android:id="@+id/tip_text"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:gravity="center_horizontal"
                            android:layout_marginVertical="32dp"
                            android:layout_marginHorizontal="32dp"
                            android:textSize="16sp"
                            android:textColor="?colorOnSurface"
                            android:text="@string/welcome_community_desc" />
                        <LinearLayout
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/screen3_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="@string/skip"
                                android:textColor="?colorPrimary"
                                android:layout_marginEnd="16dp"
                                style="@style/Widget.Material3Expressive.Button.OutlinedButton" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/join_button"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="@string/welcome_join_community" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/final_screen"
                android:layout_height="match_parent"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/done_icon"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:padding="25dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/intro_illustration_4"
                        android:layout_marginHorizontal="70dp" />
                    <TextView
                        android:id="@+id/final_text"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_marginVertical="30dp"
                        android:layout_marginHorizontal="30dp"
                        android:textSize="16sp"
                        android:textColor="?colorOnSurface"
                        android:text="@string/welcome_ready" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/start_button"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="@string/welcome_lets_go" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:gravity="center"
                android:id="@+id/part_2_view">
                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">
                    <com.google.android.material.loadingindicator.LoadingIndicator
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_margin="16dp"
                        style="@style/Widget.Material3.LoadingIndicator.Contained" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        app:trackThickness="5dp"
                        app:indicatorTrackGapSize="4dp"
                        app:trackStopIndicatorSize="0dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
