<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Coordinator"
    android:background="?colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.xapps.media.xmusic.widget.ExpressiveTabs
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="15dp"
        android:background="@null" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/root_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:strokeWidth="0dp"
        app:elevation="2dp"
        app:cardCornerRadius="24dp">

        <LinearLayout
            android:id="@+id/music_frag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewpager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:strokeWidth="0dp"
        app:elevation="2dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/search_frag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:name="com.xapps.media.xmusic.fragment.SearchFragment" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/settings_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:strokeWidth="0dp"
        app:elevation="2dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settings_frag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:name="com.xapps.media.xmusic.fragment.SettingsFragment"
            android:background="?colorSurfaceContainer" />

    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/layout_scrim"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000"
        android:alpha="0" />

    <com.xapps.media.xmusic.widget.ExpressiveSliderLayout
        android:id="@+id/mini_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.xapps.media.xmusic.widget.RemainingHeightLinearLayout
            android:id="@+id/container_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <include
                android:id="@+id/collapsed_player"
                android:clipChildren="false"
                android:clipToPadding="false"
                layout="@layout/layout_player_collapsed" />

            <com.xapps.media.xmusic.widget.CoverSpaceLayout
                android:id="@+id/maximum_size_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="10"
                android:paddingHorizontal="24dp"
                android:layout_marginBottom="24dp" />

            <include
                android:id="@+id/expanded_player"
                layout="@layout/layout_player_expanded" />

        </com.xapps.media.xmusic.widget.RemainingHeightLinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lyrics_container"
            android:layout_height="match_parent"
            android:alpha="0"
            android:translationY="50px"
            android:layout_width="match_parent"
            android:visibility="gone"
            tools:ignore="PxUsage">
            <com.xapps.media.xmusic.widget.GradientView
                android:id="@+id/gradient_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <FrameLayout
                android:id="@+id/lyrics_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/placeholder_lyrics_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text="@string/lyrics_not_found"
                    android:textColor="?colorOnSurface"
                    android:alpha="0.85"
                    android:textSize="24sp" />
            </FrameLayout>

            <com.xapps.media.xmusic.widget.XLyricsContainerView
                android:id="@+id/lyrics_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.xapps.media.xmusic.widget.ExpressiveSliderLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:translationY="5dp"
        android:alpha="0"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:background="?colorSurface"
        android:translationZ="-1dp"
        app:elevation="0dp"
        android:elevation="0dp"
        app:menu="@menu/bnv_menu"
        app:labelVisibilityMode="selected"
        app:paddingBottomSystemWindowInsets="false" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
