<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/state_checked" android:drawable="@drawable/settings_filled_24px" android:state_checked="true" />
    <item android:id="@+id/state_unchecked" android:drawable="@drawable/settings_24px" />
    <transition android:fromId="@id/state_unchecked" android:toId="@id/state_checked" android:drawable="@drawable/settings_avd_in" />
    <transition android:fromId="@id/state_checked" android:toId="@id/state_unchecked" android:drawable="@drawable/settings_avd_out" />
</animated-selector>
